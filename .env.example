# ==============================================================================
# Streamerz TikTok Extension Marketplace API Credentials
# Copy this file to .env (do NOT commit .env to git) and fill in your keys.
# ==============================================================================

# 1. Google Chrome Web Store
# - CHROME_EXTENSION_ID: The 32-character ID from your Web Store dashboard URL
# - CHROME_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console
# - CHROME_CLIENT_SECRET: OAuth 2.0 Client Secret from Google Cloud Console
# - CHROME_REFRESH_TOKEN: Generated via Google OAuth 2.0 Playground
CHROME_EXTENSION_ID=anckdakmhognoancpeefjlgicihplcjc
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# 2. Microsoft Edge Add-ons
# - EDGE_PRODUCT_ID: The GUID from your Microsoft Partner Center extension URL
# - EDGE_CLIENT_ID: Azure Active Directory / Entra ID App Client ID
# - EDGE_API_KEY: Azure Active Directory Client Secret
# - EDGE_TENANT_ID: Azure Active Directory Tenant ID (Directory ID)
EDGE_PRODUCT_ID=98d0235c-b425-4d57-82f0-26c1f0b7dc71
EDGE_CLIENT_ID=
EDGE_API_KEY=
EDGE_TENANT_ID=

# 3. Mozilla Firefox Add-ons (AMO)
# - AMO_JWT_ISSUER: Generated at https://addons.mozilla.org/en-US/developers/addon/api/key/
# - AMO_JWT_SECRET: Generated at https://addons.mozilla.org/en-US/developers/addon/api/key/
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
