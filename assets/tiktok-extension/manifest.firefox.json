{
  "manifest_version": 2,
  "name": "Streamerz for TikTok",
  "version": "1.4.0",
  "description": "Connects Streamerz to your TikTok account for search and LIVE chat, without a visible helper tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiktok-bridge@streamerz.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "tabs",
    "cookies",
    "storage",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "scripts": [
      "bridge.js"
    ],
    "persistent": true
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/live/history/center*",
        "https://www.tiktok.com/login*"
      ],
      "js": [
        "frame.js"
      ],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
