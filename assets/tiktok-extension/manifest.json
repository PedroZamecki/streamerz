{
  "manifest_version": 3,
  "name": "Streamerz for TikTok",
  "version": "1.2.0",
  "description": "Connects Streamerz to your TikTok account for search and LIVE chat, without a visible helper tab.",
  "key": "",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "tabs",
    "offscreen",
    "cookies",
    "background",
    "storage"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "bridge.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/live/history/center*",
        "https://www.tiktok.com/login*"
      ],
      "js": [
        "frame.js"
      ],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
