{
  "manifest_version": 3,
  "name": "Streamerz for TikTok",
  "version": "1.0.0",
  "description": "Sends your TikTok LIVE chat messages from Streamerz through your own logged-in TikTok tab.",
  "key": "",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "bridge.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "116"
}
