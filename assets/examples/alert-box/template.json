              "event": "sent Rose x3",
              "icon": "gift",
              "kind": "gift",
              "trigger": "Test",
              "args": {
                "giftName": "Rose",
                "giftId": 5655,
                "repeatCount": 3,
                "coins": 3
              },
              "text": "",
              "time": "12:00",
              "badges": [],
              "parts": []
            }
          ]
        ]
      }
    }
  }
}
