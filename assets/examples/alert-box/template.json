                {
                  "t": "Love the stream"
                }
              ]
            }
          ],
          [
            "Chat.Alert",
            {
              "platform": "kick",
              "user": "Cy",
              "userId": "test-cy",
              "event": "is raiding with 42 viewers",
              "icon": "swords",
