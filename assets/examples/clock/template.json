{
  "format": 1,
  "name": "Clock",
  "meta": {
    "description": "The time of day. The simplest example: a few settings and no feed.",
    "variables": [
      {
        "name": "format",
        "label": "Format",
        "kind": "choice",
        "default": "24 hours",
        "options": [
          "24 hours",
          "12 hours"
        ]
      },
      {
        "name": "seconds",
        "label": "Show the seconds",
        "kind": "boolean",
        "default": false
      },
      {
        "name": "label",
        "label": "Label",
        "kind": "text",
        "default": "",
        "description": "A small text above the time. Empty for none"
      },
      {
        "name": "color",
        "label": "Color",
        "kind": "color",
        "default": "#ffffff"
      },
      {
        "name": "size",
        "label": "Size",
        "kind": "slider",
        "default": 64,
        "description": "In pixels",
        "min": 16,
        "max": 240,
        "step": 2
      }
    ],
    "files": [
      {
        "name": "index.html"
      }
    ],
    "template": {
      "id": "streamerz.example.clock",
      "version": "1.1.0",
      "author": "Streamerz",
      "pages": [
        {
          "file": "index.html",
          "title": "Clock",
          "width": 420,
          "height": 160
        }
      ]
    }
  }
}
