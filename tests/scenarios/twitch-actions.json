      "GET chat/chatters": {"total": 2, "data": [{"user_id": "5", "user_login": "ana", "user_name": "Ana"}, {"user_id": "6", "user_login": "bo", "user_name": "Bo"}]}}},
    "actions": [{"name": "info", "subActions": [
