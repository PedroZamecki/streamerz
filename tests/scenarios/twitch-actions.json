  {
    "name": "twitch: moderation (timeout, ban, unban, untimeout, warn, clear chat)",
    "fakes": {"twitch": {"resolve": {"troll": "666"}}},
    "actions": [{"name": "mod", "subActions": [
      {"type": 20, "userLogin": "troll", "duration": 600, "reason": "spam"},
      {"type": 511, "userLogin": "troll", "reason": "bad"},
      {"type": 512, "userLogin": "@troll"},
      {"type": 513, "userLogin": "troll"},
      {"type": 565, "userLogin": "troll", "reason": "be nice"},
      {"type": 510}]}],
    "steps": [{"run": "mod"}],
    "expect": {
      "calls": [
        {"call": "POST moderation/bans", "body": {"data": {"user_id": "666", "duration": 600, "reason": "spam"}}},
        {"call": "POST moderation/bans", "body": {"data": {"user_id": "666", "reason": "bad"}}},
        {"call": "DELETE moderation/bans", "query": {"user_id": "666"}},
        {"call": "DELETE moderation/bans", "query": {"user_id": "666"}},
        {"call": "POST moderation/warnings", "body": {"data": {"user_id": "666", "reason": "be nice"}}},
        {"call": "DELETE moderation/chat"}],
      "runs": [{"action": "mod", "after": {"timeoutResult": true, "timedOutUserId": "666", "banResult": true, "bannedUserId": "666",
        "unbanResult": true, "unbannedUserName": "troll", "unTimedOutResult": true, "warnedResult": true, "warnedUserId": "666", "clearSuccess": true}}]}
  },
