    "steps": [{"run": "info"}],
    "expect": {
      "calls": [{"call": "GET streams", "query": {"user_id": "{broadcaster_id}"}}, {"call": "GET users", "query": {"id": "1"}},
                {"call": "GET chat/chatters", "query": {"first": "1000"}}, {"call": "GET chat/chatters"}],
      "runs": [{"action": "info", "after": {"viewerCount": 33, "broadcastUser": "Streamer", "broadcastIsAffiliate": true,
        "broadcastIsPartner": false, "randomUsersAdded": 2, "randomUserType0": "twitch", "presentUser": "Bo",
        "presentUserId": "6", "presentUsersCount": 2}}]}
  },
  {
