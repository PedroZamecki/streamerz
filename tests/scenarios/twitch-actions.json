[
  {
    "name": "twitch: chat message, reply and announcement",
    "fakes": {"twitch": {}},
    "actions": [{"name": "talk", "subActions": [
      {"type": 10, "text": "hello %user%", "useBot": true},
      {"type": 560, "text": "replying", "replyId": "%msgId%"},
      {"type": 23, "text": "big news", "color": "purple", "useBot": false}]}],
    "steps": [{"run": "talk", "args": {"user": "ana", "msgId": "m1"}}],
    "expect": {"chat": [{"platform": "twitch", "text": "hello ana", "bot": true}, {"platform": "twitch", "text": "replying"}],
               "calls": [{"platform": "twitch", "call": "announce", "text": "big news", "color": "purple", "bot": false}]}
  },
  {
    "name": "twitch: nothing is sent when Twitch isn't connected",
    "actions": [{"name": "act", "subActions": [
      {"type": 23, "text": "big news"}, {"type": 15, "title": "t"}, {"type": 20, "userLogin": "x", "duration": 5},
      {"type": 1020, "logLevel": 2, "message": "title=%titleSuccess% timeout=%timeoutResult%"}]}],
    "steps": [{"run": "act"}],
    "expect": {"log": ["title=False timeout=False"], "notCalls": ["twitch"]}
  },
  {
    "name": "twitch: chat modes (subscriber, emote, slow, follower)",
    "fakes": {"twitch": {}},
    "actions": [{"name": "modes", "subActions": [
      {"type": 12, "status": true}, {"type": 13, "status": false},
      {"type": 14, "status": true, "duration": 30}, {"type": 28, "status": true, "duration": 10}]}],
    "steps": [{"run": "modes"}],
    "expect": {"calls": [
      {"call": "PATCH chat/settings", "query": {"broadcaster_id": "{broadcaster_id}", "moderator_id": "{moderator_id}"}, "body": {"subscriber_mode": true}},
      {"call": "PATCH chat/settings", "body": {"emote_mode": false}},
      {"call": "PATCH chat/settings", "body": {"slow_mode": true, "slow_mode_wait_time": 30}},
      {"call": "PATCH chat/settings", "body": {"follower_mode": true, "follower_mode_duration": 10}}]}
  },
  {
    "name": "twitch: title, game by name, stream marker, clip and commercial",
    "fakes": {"twitch": {
      "GET games": {"data": [{"id": "509658", "name": "Just Chatting", "box_art_url": "https://x/{width}x{height}.jpg"}]},
      "POST streams/markers": {"data": [{"id": "mk1", "created_at": "2026-01-01T00:00:00Z", "description": "here", "position_seconds": 42}]},
      "POST clips": {"data": [{"id": "Clip1"}]}}},
    "actions": [{"name": "channel", "subActions": [
      {"type": 15, "title": "Playing with %user%"},
      {"type": 16, "source": 0, "game": "just chatting"},
      {"type": 17, "description": "here"},
      {"type": 18, "hasDelay": true},
      {"type": 19, "duration": 60}]}],
    "steps": [{"run": "channel", "args": {"user": "ana"}}],
    "expect": {
      "calls": [
        {"call": "PATCH channels", "body": {"title": "Playing with ana"}},
        {"call": "GET games", "query": {"name": "just chatting"}},
        {"call": "PATCH channels", "body": {"game_id": "509658"}},
        {"call": "POST streams/markers", "body": {"user_id": "{broadcaster_id}", "description": "here"}},
        {"call": "POST clips", "query": {"has_delay": "true"}},
        {"call": "POST channels/commercial", "body": {"length": 60}}],
      "runs": [{"action": "channel", "after": {"titleSuccess": true, "gameSuccess": true, "gameName": "Just Chatting",
        "gameBoxArt": "https://x/285x380.jpg", "streamMarkerSuccess": true, "streamMarkerId": "mk1", "streamMarkerPosition": 42,
        "createClipSuccess": true, "createClipId": "Clip1", "createClipUrl": "https://clips.twitch.tv/Clip1"}}]}
  },
  {
    "name": "twitch: a failed request sets the result false and logs",
    "fakes": {"twitch": {"PATCH channels": {"error": "HTTP 401 missing scope"}}},
    "actions": [{"name": "title", "subActions": [{"type": 15, "title": "x"}]}],
    "steps": [{"run": "title"}],
    "expect": {"log": ["Twitch: HTTP 401 missing scope"], "runs": [{"action": "title", "after": {"titleSuccess": false}}]}
  },
  {
    "name": "twitch: tags (set, clear, add, remove) and branded content",
    "fakes": {"twitch": {"GET channels": {"data": [{"tags": ["English", "Chill"]}]}}},
    "actions": [{"name": "tags", "subActions": [
      {"type": 252, "tags": ["Cozy", "%lang%"]},
