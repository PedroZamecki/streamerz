      {"type": 99512},
      {"type": 99513, "userLogin": "ana"}
    ]}],
    "steps": [{"run": "queue", "args": {"messageId": "h1", "requestId": "r1"}}],
    "expect": {
      "calls": [
        {"platform": "twitch", "call": "POST moderation/automod/message", "body": {"msg_id": "h1", "action": "ALLOW", "user_id": "{moderator_id}"}},
        {"platform": "twitch", "call": "POST moderation/automod/message", "body": {"msg_id": "h2", "action": "DENY"}},
        {"platform": "twitch", "call": "GET moderation/unban_requests", "query": {"status": "pending"}},
        {"platform": "twitch", "call": "PATCH moderation/unban_requests", "query": {"unban_request_id": "r1", "status": "approved", "resolution_text": "ok"}},
        {"platform": "twitch", "call": "GET moderation/moderators"},
        {"platform": "twitch", "call": "GET channels/vips"},
        {"platform": "twitch", "call": "GET subscriptions", "query": {"user_id": "id-ana"}}
      ],
      "runs": [{"action": "queue", "after": {"autoModResult": true, "unbanRequestCount": 1, "unbanRequest0Id": "r1", "unbanRequest0Text": "sorry",
        "unbanRequestResult": true, "moderatorCount": 1, "moderator0UserName": "mod", "vipCount": 2, "vip1User": "Pal",
        "isSubscribed": true, "subscriptionTier": 2, "isGift": true, "gifterUser": "Bob"}}]
    }
  },
