[
  {
    "name": "twitch tools: delete, purge, send and pin, whisper are kept in dev mode; chat modes read and change",
    "fakes": {"twitch": {
      "GET chat/settings": {"data": [{"emote_mode": true, "slow_mode": true, "slow_mode_wait_time": 30, "unique_chat_mode": false,
        "non_moderator_chat_delay": false, "follower_mode": false, "subscriber_mode": false}]}
    }},
    "actions": [{"name": "mod", "subActions": [
      {"type": 99500, "messageId": "%msgId%"},
      {"type": 99501, "userLogin": "%userName%", "reason": "spam"},
      {"type": 99502, "text": "Read the rules", "duration": 60},
      {"type": 99503, "userLogin": "bob", "text": "psst"},
      {"type": 99504, "state": 0},
      {"type": 99505, "state": 0, "delay": 1},
      {"type": 99506}
    ]}],
    "steps": [{"run": "mod", "args": {"msgId": "m1", "userName": "ana", "userType": "twitch"}}],
    "expect": {
      "chat": [{"platform": "twitch", "text": "/delete m1"}, {"platform": "twitch", "text": "/timeout ana 1"},
        {"platform": "twitch", "text": "/pin Read the rules"}, {"platform": "twitch", "text": "/w bob psst"}],
      "calls": [
        {"platform": "twitch", "call": "resolve", "login": "ana"},
        {"platform": "twitch", "call": "resolve", "login": "bob"},
        {"platform": "twitch", "call": "GET chat/settings"},
        {"platform": "twitch", "call": "PATCH chat/settings", "body": {"unique_chat_mode": true}},
        {"platform": "twitch", "call": "PATCH chat/settings", "body": {"non_moderator_chat_delay": true, "non_moderator_chat_delay_duration": 4}}
      ],
      "runs": [{"action": "mod", "after": {"deleteResult": true, "purgeResult": true, "pinResult": true, "whisperResult": true, "emoteOnly": true, "slowMode": true, "slowModeWaitTime": 30, "uniqueChat": false}}]
    }
  },
  {
    "name": "twitch tools: AutoMod, unban requests, moderators, VIPs and subscriptions",
    "fakes": {"twitch": {
      "GET moderation/unban_requests": {"data": [{"id": "r1", "user_name": "Ana", "user_login": "ana", "user_id": "5", "text": "sorry"}]},
      "GET moderation/moderators": {"data": [{"user_name": "Mod", "user_login": "mod", "user_id": "9"}]},
      "GET channels/vips": {"data": [{"user_name": "Vee", "user_login": "vee", "user_id": "8"}, {"user_name": "Pal", "user_login": "pal", "user_id": "7"}]},
      "GET subscriptions": {"data": [{"tier": "2000", "is_gift": true, "gifter_name": "Bob"}]}
    }},
    "actions": [{"name": "queue", "subActions": [
      {"type": 99507, "messageId": "%messageId%"},
      {"type": 99508, "messageId": "h2"},
      {"type": 99509, "status": 0},
      {"type": 99510, "requestId": "%requestId%", "approve": true, "resolutionText": "ok"},
