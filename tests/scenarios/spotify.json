  {
    "name": "spotify: current song and add to queue; a failure sets spotifyError and fires Spotify Error",
    "fakes": {"spotify": {"current": {"name": "Song", "artists": ["Art"], "uri": "spotify:track:t1"}}},
    "actions": [
      {"name": "now", "subActions": [{"type": 99810}, {"type": 99819, "value": "spotify:track:zz"}]},
      {"name": "err", "triggers": [{"type": 99806}], "subActions": [{"type": 1020, "logLevel": 2, "message": "spotify error: %error%"}]},
      {"name": "fail", "subActions": [{"type": 99813}]}
    ],
    "steps": [
      {"run": "now"}
    ],
    "expect": {"calls": [{"platform": "spotify", "call": "current"}, {"platform": "spotify", "call": "find", "query": "spotify:track:zz"}, {"platform": "spotify", "call": "add"}], "runs": [{"action": "now", "after": {"spotifyError": ""}}]}
  },
  {
    "name": "spotify: with no Spotify connected an action says so",
    "actions": [
      {"name": "fail", "subActions": [{"type": 99813}, {"type": 1020, "logLevel": 2, "message": "err=%spotifyError%"}]},
      {"name": "on error", "triggers": [{"type": 99806}], "subActions": [{"type": 1020, "logLevel": 2, "message": "Spotify Error fired"}]}
    ],
    "steps": [
      {"run": "fail"}
    ],
    "expect": {"log": ["err=", "Spotify Error fired"], "runs": [{"action": "fail", "after": {"spotifyResult": null}}]}
  },
