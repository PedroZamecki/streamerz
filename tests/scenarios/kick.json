    "expect": {"calls": [{"platform": "kick", "call": "GET /channels?slug=pal"}, {"platform": "kick", "call": "title", "title": "New title"}, {"platform": "kick", "call": "GET https://api.kick.com/public/v2/categories?name=just+chatting"}, {"platform": "kick", "call": "category", "id": 1}], "runs": [{"action": "chan", "after": {"addTargetResult": true, "targetUserId": 77, "game": "Chess", "tagCount": 2, "tagsDelimited": "a, b", "titleSuccess": true, "category.success": true, "category.name": "Just Chatting"}}]}
  },
  {
    "name": "kick: moderation (ban, unban, timeout, untimeout)",
    "fakes": {"kick": {}},
    "actions": [
      {"name": "mod", "subActions": [{"type": 35040, "userLogin": "troll", "reason": "spam"}, {"type": 35041, "userLogin": "troll"}, {"type": 35042, "userLogin": "troll", "duration": 10, "reason": "calm"}, {"type": 35043, "userLogin": "troll"}]}
    ],
    "steps": [
      {"run": "mod"}
