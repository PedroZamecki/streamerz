    "expect": {"calls": [{"platform": "kick", "call": "ban", "login": "troll", "reason": "spam"}, {"platform": "kick", "call": "unban", "login": "troll"}, {"platform": "kick", "call": "timeout", "login": "troll", "duration": 10, "reason": "calm"}, {"platform": "kick", "call": "untimeout", "login": "troll"}], "runs": [{"action": "mod", "after": {"banResult": true, "unbanResult": true, "timeoutResult": true, "unTimedOutResult": true, "timedOutUserType": "kick"}}]}
  },
  {
    "name": "kick: a failed moderation call sets its result false",
    "fakes": {"kick": {"ban": {"error": "Kick: 403 forbidden"}}},
    "actions": [
      {"name": "mod", "subActions": [{"type": 35040, "userLogin": "troll"}]}
    ],
    "steps": [
      {"run": "mod"}
    ],
    "expect": {"log": ["Kick: 403 forbidden"], "runs": [{"action": "mod", "after": {"banResult": false}}]}
  },
