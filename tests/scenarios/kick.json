[
  {
    "name": "kick: random users with Memory Saver and no chat history",
    "config": {"memory_saver": true, "window": {"chat": {"saveHistory": false}}},
    "actions": [{"name": "pick", "subActions": [{"type": 35012, "count": 3}]}],
    "steps": [
      {"event": {"platform": "kick", "type": "App\\Events\\ChatMessageEvent", "channel": "streamer", "data": {"id": "k1", "content": "hello", "type": "message", "sender": {"id": 5, "username": "Ana", "slug": "ana", "identity": {"color": "#FF0000", "badges": []}}}}},
      {"run": "pick"}
    ],
    "expect": {"runs": [{"action": "pick", "after": {"randomUsersCount": 1, "randomUser0": "Ana", "randomUserType0": "kick"}}]}
  },
  {
    "name": "kick: chat, reply, broadcaster info and random users",
    "config": {"kick": {"channel": "Streamer"}, "window": {"chat": {"saveHistory": false}}},
    "fakes": {"kick": {"GET /channels?slug=streamer": {"data": [{"broadcaster_user_id": 1001}]}}},
    "actions": [
      {"name": "talk", "subActions": [{"type": 35001, "text": "hi %user%"}, {"type": 35002, "text": "re", "replyId": "%msgId%"}, {"type": 35010}, {"type": 35012, "count": 3}]}
    ],
    "steps": [
      {"event": {"platform": "kick", "type": "App\\Events\\ChatMessageEvent", "channel": "streamer", "data": {"id": "k1", "content": "hello", "type": "message", "sender": {"id": 5, "username": "Ana", "slug": "ana", "identity": {"color": "#FF0000", "badges": []}}}}},
      {"run": "talk", "args": {"user": "ana", "msgId": "k1"}}
    ],
    "expect": {"chat": [{"platform": "kick", "text": "hi ana"}, {"platform": "kick", "text": "re"}], "runs": [{"action": "talk", "after": {"broadcastUser": "Streamer", "broadcastUserType": "kick", "broadcastUserId": "1001", "randomUsersCount": 1, "randomUser0": "Ana", "randomUserType0": "kick"}}]}
  },
  {
    "name": "kick: target info, title and category",
    "fakes": {"kick": {"GET /channels?slug=pal": {"data": [{"slug": "pal", "broadcaster_user_id": 77, "channel_description": "d", "stream_title": "Live!", "category": {"id": 15, "name": "Chess"}, "stream": {"custom_tags": ["a", "b"]}}]}, "GET https://api.kick.com/public/v2/categories?name=just+chatting": {"data": [{"id": 1, "name": "Just Chatting", "thumbnail": "t"}]}}},
    "actions": [
